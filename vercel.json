{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"dev\" ]",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "huellavet-la25-dev.vercel.app" }],
      "destination": "https://paw-apigateway-tpintegrador-dev.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://paw-apigateway-tpintegrador.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}